{"description":"","userTags":[],"hardwareTags":["zowi","Arduino UNO"],"compiled":false,"imageType":"","videoUrl":"","defaultTheme":"infotab_option_colorTheme","software":{"vars":{"name":"varsBloq","content":[[]],"enable":true,"childs":[]},"setup":{"name":"setupBloq","content":[[]],"enable":true,"childs":[{"name":"zowiHome","content":[[]],"enable":true}]},"loop":{"name":"loopBloq","content":[[]],"enable":true,"childs":[{"name":"zowiMouth","content":[[{"alias":"staticDropdown","id":"GESTURE","value":"smile_code"}]],"enable":true},{"name":"zowiIfSound","content":[[]],"enable":true,"childs":[{"name":"zowiSounds","content":[[{"alias":"staticDropdown","id":"SOUND","value":"S_OhOoh"}]],"enable":true},{"name":"zowiGestures","content":[[{"alias":"staticDropdown","id":"GESTURE","value":"ZowiLove"}]],"enable":true}]},{"name":"zowiIfButtons","content":[[{"alias":"staticDropdown","id":"BUTTON","value":"PIN_AButton"}]],"enable":true,"childs":[{"name":"zowiGestures","content":[[{"alias":"staticDropdown","id":"GESTURE","value":"ZowiHappy"}]],"enable":true},{"name":"zowiSounds","content":[[{"alias":"staticDropdown","id":"SOUND","value":"S_happy"}]],"enable":true}]},{"name":"zowiIfButtons","content":[[{"alias":"staticDropdown","id":"BUTTON","value":"PIN_BButton"}]],"enable":true,"childs":[{"name":"zowiGestures","content":[[{"alias":"staticDropdown","id":"GESTURE","value":"ZowiSleeping"}]],"enable":true},{"name":"zowiSounds","content":[[{"alias":"staticDropdown","id":"SOUND","value":"S_sleeping"}]],"enable":true}]}]}},"hardware":{"components":[],"connections":[],"board":"Arduino UNO","robot":"zowi"},"code":"/***   Included libraries  ***/\n#include <BitbloqZowi.h>\n#include <BitbloqUS.h>\n#include <BitbloqBatteryReader.h>\n#include <BitbloqLedMatrix.h>\n#include <Servo.h>\n#include <BitbloqOscillator.h>\n#include <EEPROM.h>\n\n\n\n\n/***   Global variables and function definition  ***/\nZowi zowi;\n\n\n\n\n/***   Setup  ***/void setup(){\nzowi.init();\n\nzowi.home();\n}\n\n\n/***   Loop  ***/void loop(){zowi.putMouth(smile_code, false);\n if(zowi.getNoise() >= 650){zowi.sing(S_OhOoh);\nzowi.playGesture(ZowiLove);\n}\nif(digitalRead(PIN_AButton) == 1){zowi.playGesture(ZowiHappy);\nzowi.sing(S_happy);\n}\nif(digitalRead(PIN_BButton) == 1){zowi.playGesture(ZowiSleeping);\nzowi.sing(S_sleeping);\n}\n}\n\n\n\n\n","exportedFromBitbloqOffline":true,"bitbloqOfflineVersion":"2.0.2","bloqsVersion":"tocalvo/bloqs"}